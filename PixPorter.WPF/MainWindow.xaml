<Window x:Class="PixPorter.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PixPorter.WPF.ViewModels"
        xmlns:conv="clr-namespace:PixPorter.WPF.Converters"
        xmlns:local="clr-namespace:PixPorter.WPF"
        Title="PixPorter"
        Height="720"
        Width="960"
        MinHeight="580"
        MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        AllowDrop="True">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:ConversionStatusToColorConverter x:Key="StatusToColor" />
        <conv:CountToVisibilityConverter x:Key="CountToVis" />
        <conv:InverseCountToVisibilityConverter x:Key="InvCountToVis" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />

        <!-- Log level color converter defined inline -->
        <conv:LogLevelToColorConverter x:Key="LogLevelToColor" />

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource BackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Width="24" Height="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleThemeButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Width="32" Height="32"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel>
                            <ContentPresenter Margin="0,0,0,8"
                                              HorizontalAlignment="Center" />
                            <Border x:Name="Underline"
                                    Height="2"
                                    CornerRadius="1"
                                    Background="Transparent" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Height" Value="38" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="30" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="15"
                                                           Text="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0"
                                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                                      StrokeThickness="1.5" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="200">
                                    <ScrollViewer Style="{StaticResource ScrollViewerStyle}"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Padding="10,8"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="15" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border Background="{TemplateBinding Background}" Padding="2">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="SliderStyle" TargetType="Slider">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="2" Background="{DynamicResource AccentBrush}" CornerRadius="1" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="{DynamicResource AccentBrush}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="2" Background="{DynamicResource BorderBrush}" CornerRadius="1" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.3" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box"
                                    Width="16" Height="16"
                                    CornerRadius="3"
                                    BorderThickness="1.5"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Background="Transparent"
                                    Margin="0,0,8,0">
                                <Path x:Name="Check"
                                      Data="M 2 8 L 6 12 L 14 4"
                                      Stroke="{DynamicResource BackgroundBrush}"
                                      StrokeThickness="1.5"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Help section header style -->
        <Style x:Key="HelpSectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- Help body text style -->
        <Style x:Key="HelpBodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

        <!-- Help tag / badge style -->
        <Style x:Key="FormatBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,4,4" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PixPorter"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <Border Width="1" Height="16"
                            Background="{DynamicResource BorderBrush}"
                            Margin="14,0" />
                    <TextBlock Text="Image Format Converter"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource ToggleThemeButton}"
                                  IsChecked="{Binding IsDark}"
                                  ToolTip="Toggle theme">
                        <TextBlock FontSize="24">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="☀" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDark}" Value="True">
                                            <Setter Property="Text" Value="☾" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="16,16,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <!-- Left: Tabbed Panel -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1.5"
                    CornerRadius="10"
                    AllowDrop="True"
                    Drop="DropZone_Drop"
                    DragEnter="DropZone_DragEnter"
                    DragLeave="DropZone_DragLeave"
                    DragOver="DropZone_DragOver">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Tab Bar -->
                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,14,20,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="QueueTab"
                                         Content="Queue"
                                         Style="{StaticResource TabButtonStyle}"
                                         IsChecked="True"
                                         Margin="0,0,24,0"
                                         GroupName="MainTabs" />
                            <RadioButton x:Name="LogTab"
                                         Content="Log"
                                         Style="{StaticResource TabButtonStyle}"
                                         Margin="0,0,24,0"
                                         GroupName="MainTabs" />
                            <RadioButton x:Name="HelpTab"
                                         Content="Help"
                                         Style="{StaticResource TabButtonStyle}"
                                         GroupName="MainTabs" />
                        </StackPanel>
                    </Border>

                    <!-- Queue Tab Content -->
                    <Grid Grid.Row="1">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=QueueTab}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <!-- Empty state -->
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding QueuedFiles.Count, Converter={StaticResource InvCountToVis}}">
                            <TextBlock Text="⬆"
                                       FontSize="30"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="0,0,0,12" />
                            <TextBlock Text="Drop images or folders here"
                                       FontSize="17" FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="or"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,12" />
                            <Button Content="Browse Files"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding BrowseFilesCommand}"
                                    FontSize="18"
                                    HorizontalAlignment="Center" />
                            <TextBlock Text="PNG · JPG · WEBP · GIF · BMP · TIFF · TGA · QOI · PBM"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,16,0,0" />
                        </StackPanel>

                        <!-- File list -->
                        <Grid Visibility="{Binding QueuedFiles.Count, Converter={StaticResource CountToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="16,12">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox Style="{StaticResource CheckBoxStyle}"
                                                  IsChecked="{Binding AllSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="{Binding QueuedFiles.Count, Mode=OneWay}" />
                                            <Run Text="file(s) queued" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Content="+ Add more"
                                            Style="{StaticResource GhostButton}"
                                            Padding="12,6"
                                            Command="{Binding BrowseFilesCommand}"
                                            HorizontalAlignment="Right"
                                            FontSize="14" />
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1"
                                          Style="{StaticResource ScrollViewerStyle}"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="12,8"
                                          PreviewMouseWheel="SmoothScroll_PreviewMouseWheel">
                                <ItemsControl ItemsSource="{Binding QueuedFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" Padding="0,6" Margin="0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="74" />
                                                        <ColumnDefinition Width="38" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Style="{StaticResource CheckBoxStyle}"
                                                              VerticalAlignment="Center"
                                                              HorizontalAlignment="Left"
                                                              Margin="16,0,0,0" />

                                                    <Border Grid.Column="1"
                                                            Width="3" Height="32"
                                                            CornerRadius="2"
                                                            Background="{Binding Status, Converter={StaticResource StatusToColor}}"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0" />

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0">
                                                        <TextBlock Text="{Binding FileName}"
                                                                   FontSize="15"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding FileSize}"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Left"
                                                                Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   FontSize="14"
                                                                   Foreground="{Binding Status, Converter={StaticResource StatusToColor}}" />
                                                        <TextBlock Text="{Binding OutputFileSize}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource SuccessBrush}"
                                                                   Visibility="{Binding OutputFileSize, Converter={StaticResource StringToVis}}"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <Button Grid.Column="4"
                                                            Style="{StaticResource IconButton}"
                                                            Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Remove">
                                                        <TextBlock Text="✕"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- Log Tab Content -->
                    <Grid Grid.Row="1">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=LogTab}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Log toolbar -->
                            <Border Grid.Row="0"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="16,12">
                                <Grid>
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               FontFamily="Cascadia Code, Consolas, Courier New">
                                        <Run Text="{Binding LogEntries.Count, Mode=OneWay}" />
                                        <Run Text="entries" />
                                    </TextBlock>
                                    <Button Content="Clear"
                                            Style="{StaticResource GhostButton}"
                                            Padding="12,6"
                                            Command="{Binding ClearLogCommand}"
                                            HorizontalAlignment="Right"
                                            FontSize="14" />
                                </Grid>
                            </Border>

                            <!-- Empty log state -->
                            <StackPanel Grid.Row="1"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding LogEntries.Count, Converter={StaticResource InvCountToVis}}">
                                <TextBlock Text="No log entries yet."
                                           FontSize="15"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Convert some files to see output here."
                                           FontSize="13"
                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <!-- Log entries -->
                            <ScrollViewer Grid.Row="1"
                                          x:Name="LogScrollViewer"
                                          Style="{StaticResource ScrollViewerStyle}"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="16,10"
                                          Visibility="{Binding LogEntries.Count, Converter={StaticResource CountToVis}}"
                                          PreviewMouseWheel="SmoothScroll_PreviewMouseWheel">
                                <ItemsControl ItemsSource="{Binding LogEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Timestamp}"
                                                           FontSize="12"
                                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           VerticalAlignment="Top"
                                                           Margin="0,1,0,0" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Message}"
                                                           FontSize="13"
                                                           FontFamily="Cascadia Code, Consolas, Courier New"
                                                           Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- Help Tab Content -->
                    <Grid Grid.Row="1">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=HelpTab}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <ScrollViewer Style="{StaticResource ScrollViewerStyle}"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="24,20,20,24"
                                      PreviewMouseWheel="SmoothScroll_PreviewMouseWheel">
                            <StackPanel>

                                <!-- Getting Started -->
                                <TextBlock Style="{StaticResource HelpSectionHeader}" Text="GETTING STARTED" />
                                <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16,14"
                                        Margin="0,0,0,20">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="1" FontSize="13" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Add files to the queue"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Margin="0,0,0,2" />
                                                <TextBlock Text="Drag &amp; drop image files or folders onto the Queue panel, or click Browse Files."
                                                           Style="{StaticResource HelpBodyText}" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="28,0,0,10" />
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="2" FontSize="13" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Choose your output format"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Margin="0,0,0,2" />
                                                <TextBlock Text="Select a target format from the dropdown, or leave it on Default to use the per-format mappings shown below."
                                                           Style="{StaticResource HelpBodyText}" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="28,0,0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="3" FontSize="13" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Convert"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Margin="0,0,0,2" />
                                                <TextBlock Text="Hit Convert. Output files are saved alongside the originals with the new extension."
                                                           Style="{StaticResource HelpBodyText}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Supported Formats -->
                                <TextBlock Style="{StaticResource HelpSectionHeader}" Text="SUPPORTED INPUT FORMATS" />
                                <WrapPanel Margin="0,0,0,6">
                                    <Border Style="{StaticResource FormatBadge}">
                                        <TextBlock Text=".png" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Cascadia Code, Consolas, Courier New"/>
                                    </Border>
                                    <Border Style="{StaticResource FormatBadge}">
                                        <TextBlock Text=".jpg / .jpeg" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Cascadia Code, Consolas, Courier New"/>
                                    </Border>
                                    <Border Style="{StaticResource FormatBadge}">
                                        <TextBlock Text=".webp" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Cascadia Code, Consolas, Courier New"/>
                                    </Border>
                                    <Border Style="{StaticResource FormatBadge}">
                                        <TextBlock Text=".gif" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Cascadia Code, Consolas, Courier New"/>
                                    </Border>
                                    <Border Style="{StaticResource FormatBadge}">
                                        <TextBlock Text=".bmp" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Cascadia Code, Consolas, Courier New"/>
                                    </Border>
                                    <Border Style="{StaticResource FormatBadge}">
                                        <TextBlock Text=".tiff" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Cascadia Code, Consolas, Courier New"/>
                                    </Border>
                                    <Border Style="{StaticResource FormatBadge}">
                                        <TextBlock Text=".tga" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Cascadia Code, Consolas, Courier New"/>
                                    </Border>
                                    <Border Style="{StaticResource FormatBadge}">
                                        <TextBlock Text=".qoi" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Cascadia Code, Consolas, Courier New"/>
                                    </Border>
                                    <Border Style="{StaticResource FormatBadge}">
                                        <TextBlock Text=".pbm" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Cascadia Code, Consolas, Courier New"/>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="Folders are scanned recursively — all supported images inside will be added."
                                           Style="{StaticResource HelpBodyText}"
                                           Margin="0,4,0,20" />

                                <!-- Default Mappings -->
                                <TextBlock Style="{StaticResource HelpSectionHeader}" Text="DEFAULT FORMAT MAPPINGS" />
                                <TextBlock Text="When output format is set to Default, each input format is converted using the mapping below."
                                           Style="{StaticResource HelpBodyText}"
                                           Margin="0,0,0,10" />
                                <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="4,4"
                                        Margin="0,0,0,20">
                                    <StackPanel>
                                        <local:MappingRow From=".webp" To=".png"  />
                                        <local:MappingRow From=".png"  To=".webp" />
                                        <local:MappingRow From=".jpg"  To=".webp" />
                                        <local:MappingRow From=".jpeg" To=".webp" />
                                        <local:MappingRow From=".gif"  To=".webp" />
                                        <local:MappingRow From=".tiff" To=".webp" />
                                        <local:MappingRow From=".bmp"  To=".webp" />
                                        <local:MappingRow From=".tga"  To=".webp" />
                                        <local:MappingRow From=".qoi"  To=".webp" />
                                        <local:MappingRow From=".pbm"  To=".webp" />
                                    </StackPanel>
                                </Border>

                                <!-- Quality Setting -->
                                <TextBlock Style="{StaticResource HelpSectionHeader}" Text="QUALITY SETTING" />
                                <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16,14"
                                        Margin="0,0,0,20">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                    <TextBlock Text="1–50" FontSize="13" FontWeight="Bold"
                                                               Foreground="{DynamicResource DestructiveBrush}"
                                                               FontFamily="Cascadia Code, Consolas, Courier New"
                                                               HorizontalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="Smaller file, noticeable compression"
                                                           Style="{StaticResource HelpBodyText}"
                                                           FontSize="12" TextAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0">
                                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                    <TextBlock Text="75–85" FontSize="13" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontFamily="Cascadia Code, Consolas, Courier New"
                                                               HorizontalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="Recommended — good balance"
                                                           Style="{StaticResource HelpBodyText}"
                                                           FontSize="12" TextAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                    <TextBlock Text="90–100" FontSize="13" FontWeight="Bold"
                                                               Foreground="{DynamicResource SuccessBrush}"
                                                               FontFamily="Cascadia Code, Consolas, Courier New"
                                                               HorizontalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="Near-lossless, larger file size"
                                                           Style="{StaticResource HelpBodyText}"
                                                           FontSize="12" TextAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,4,0,10" />
                                        <TextBlock Text="Quality only applies to JPG, PNG, and WebP output. Lossless formats like BMP and TIFF ignore this setting."
                                                   Style="{StaticResource HelpBodyText}" FontSize="12" />
                                    </StackPanel>
                                </Border>

                                <!-- Metadata -->
                                <TextBlock Style="{StaticResource HelpSectionHeader}" Text="METADATA STRIPPING" />
                                <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16,14"
                                        Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="When enabled, the following metadata is removed from output files:"
                                                   Style="{StaticResource HelpBodyText}"
                                                   Margin="0,0,0,10" />
                                        <WrapPanel>
                                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                                                <TextBlock Text="EXIF" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontFamily="Cascadia Code, Consolas, Courier New"/>
                                            </Border>
                                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                                                <TextBlock Text="IPTC" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontFamily="Cascadia Code, Consolas, Courier New"/>
                                            </Border>
                                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                                                <TextBlock Text="XMP" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontFamily="Cascadia Code, Consolas, Courier New"/>
                                            </Border>
                                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                                                <TextBlock Text="ICC Profile" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontFamily="Cascadia Code, Consolas, Courier New"/>
                                            </Border>
                                        </WrapPanel>
                                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,8,0,10" />
                                        <TextBlock Style="{StaticResource HelpBodyText}" FontSize="12">
                                            <Run Text="Useful for" />
                                            <Run Text="privacy" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Run Text="(strips GPS, camera, and author data) and for" />
                                            <Run Text="smaller files." FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Run Text="ICC stripping may affect color accuracy in color-managed workflows." />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Tips -->
                                <TextBlock Style="{StaticResource HelpSectionHeader}" Text="TIPS" />
                                <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16,14"
                                        Margin="0,0,0,4">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="→" FontSize="13"
                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="Drop an entire folder to batch-convert all supported images inside, including subfolders."
                                                       Style="{StaticResource HelpBodyText}" />
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="→" FontSize="13"
                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="Use the checkbox in the queue header to quickly select or deselect all files, then remove just the ones you don't need."
                                                       Style="{StaticResource HelpBodyText}" />
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="→" FontSize="13"
                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="Output files are written next to the originals. No files are overwritten — existing outputs are skipped with a warning in the Log."
                                                       Style="{StaticResource HelpBodyText}" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="→" FontSize="13"
                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="Check the Log tab after conversion for a detailed summary of what succeeded, was skipped, or failed."
                                                       Style="{StaticResource HelpBodyText}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Border>

            <!-- Drop overlay — sits on top of the entire left panel, only active on Queue tab -->
            <Border Grid.Column="0"
                    BorderThickness="1.5"
                    CornerRadius="10"
                    IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource DropZoneActiveBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- Right Panel -->
            <Border Grid.Column="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Settings -->
                    <StackPanel Grid.Row="0">
                        <StackPanel>
                            <TextBlock Text="OUTPUT FORMAT"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="0,0,0,8" />
                            <ComboBox Style="{StaticResource ComboBoxStyle}"
                                      FontWeight="SemiBold"
                                      ItemsSource="{Binding FormatOptions}"
                                      SelectedItem="{Binding SelectedFormatOption, Mode=TwoWay}" />
                            <TextBlock Text="Default: see per-format default mappings"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,16,0,16" />

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding QualitySupported}" Value="False">
                                            <Setter Property="Opacity" Value="0.4" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="QUALITY"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="15" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="{Binding Quality, Mode=OneWay}" /><Run Text="%" />
                                </TextBlock>
                            </Grid>
                            <Slider Style="{StaticResource SliderStyle}"
                                    Minimum="1" Maximum="100"
                                    Value="{Binding Quality}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    IsEnabled="{Binding QualitySupported}" />
                            <TextBlock Text="Applicable when output is set to JPG, PNG, or WebP"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,16,0,16" />

                        <StackPanel Margin="0,0,0,0">
                            <TextBlock Text="STRIP METADATA"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="0,0,0,8" />
                            <Grid Height="16">
                                <TextBlock VerticalAlignment="Center" FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Disabled" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StripMetadata}" Value="True">
                                                    <Setter Property="Text" Value="Enabled" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ToggleButton IsChecked="{Binding StripMetadata, Mode=TwoWay}"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Cursor="Hand">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleThemeButton}">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <Border Width="28" Height="16" CornerRadius="8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StripMetadata}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Ellipse Width="10" Height="10"
                                                 Fill="{DynamicResource BackgroundBrush}"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                    <Setter Property="Margin" Value="3,0,0,0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StripMetadata}" Value="True">
                                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                                            <Setter Property="Margin" Value="0,0,3,0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Border>
                                </ToggleButton>
                            </Grid>
                            <TextBlock Text="Removes EXIF, IPTC, XMP, and ICC data from the output file."
                                       FontSize="13"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,16,0,16" />

                        <!-- Status Information -->
                        <TextBlock Text="STATUS INFORMATION"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,0,0,8" />
                        <Border CornerRadius="6" Padding="12,9" MinHeight="38"
                                Background="{DynamicResource SurfaceElevatedBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                            <Setter Property="Background" Value="#1A2020" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="14" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding StatusMessage}" />
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        <Setter Property="Opacity" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasStatusMessage}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DestructiveBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,16,0,0" />
                    </StackPanel>

                    <!-- Spacer row -->
                    <Border Grid.Row="1" Height="16" />

                    <!-- Filler -->
                    <Border Grid.Row="2" />

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="3">
                        <Button Content="{Binding ConvertButtonText}"
                                Style="{StaticResource FlatButton}"
                                Command="{Binding ConvertCommand}"
                                IsEnabled="{Binding IsConverting, Converter={StaticResource InvBoolToVis}}"
                                HorizontalAlignment="Stretch"
                                Height="42" FontSize="16"
                                Margin="0,0,0,16" />
                        <Button Content="Clear Queue"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding ClearQueueCommand}"
                                Height="42" FontSize="16" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
