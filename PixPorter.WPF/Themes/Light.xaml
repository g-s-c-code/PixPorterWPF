<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BackgroundColor">#FAFAFA</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceElevatedColor">#F0F0F2</Color>
    <Color x:Key="BorderColor">#C4C4C8</Color>
    <Color x:Key="BorderSubtleColor">#DCDCE0</Color>
    <Color x:Key="TextPrimaryColor">#09090B</Color>
    <Color x:Key="TextSecondaryColor">#3F3F46</Color>
    <Color x:Key="TextTertiaryColor">#71717A</Color>
    <Color x:Key="AccentColor">#18181B</Color>
    <Color x:Key="AccentDimColor">#D4D4D8</Color>
    <Color x:Key="DestructiveColor">#DC2626</Color>
    <Color x:Key="SuccessColor">#005F87</Color>
    <Color x:Key="DropZoneActiveColor">#F0F0F2</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="DestructiveBrush" Color="{StaticResource DestructiveColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="DropZoneActiveBrush" Color="{StaticResource DropZoneActiveColor}" />
</ResourceDictionary>