<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BackgroundColor">#FAFAFA</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceElevatedColor">#F4F4F5</Color>
    <Color x:Key="BorderColor">#E4E4E7</Color>
    <Color x:Key="BorderSubtleColor">#F0F0F0</Color>
    <Color x:Key="TextPrimaryColor">#09090B</Color>
    <Color x:Key="TextSecondaryColor">#71717A</Color>
    <Color x:Key="TextTertiaryColor">#A1A1AA</Color>
    <Color x:Key="AccentColor">#09090B</Color>
    <Color x:Key="AccentDimColor">#E4E4E7</Color>
    <Color x:Key="DestructiveColor">#DC2626</Color>
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="DropZoneActiveColor">#F4F4F5</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="DestructiveBrush" Color="{StaticResource DestructiveColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="DropZoneActiveBrush" Color="{StaticResource DropZoneActiveColor}" />

</ResourceDictionary>